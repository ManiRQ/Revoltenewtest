{
  "name": "deskpilot",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "api"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace @deskpilot/api\" \"npm run dev --workspace @deskpilot/frontend\"",
    "start": "npm run start --workspace @deskpilot/api",
    "build": "npm run build --workspace @deskpilot/api && npm run build --workspace @deskpilot/frontend",
    "lint": "eslint frontend api eslint.config.mjs",
    "typecheck": "npm run typecheck --workspace @deskpilot/api && npm run typecheck --workspace @deskpilot/frontend",
    "test": "npm run test --workspace @deskpilot/api",
    "format": "prettier --write",
    "audit": "npm audit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.15",
    "better-auth": "^1.7.15",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "lucide-react": "^1.67.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "minimatch": "^11.0.1"
  }
}
