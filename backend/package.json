{
  "name": "todo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run db:migrate && node --watch src/server.js",
    "start": "npm run db:migrate && node src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "node --check src/server.js",
    "lint": "eslint src tests drizzle.config.js eslint.config.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" drizzle.config.js eslint.config.js package.json",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" drizzle.config.js eslint.config.js package.json",
    "test": "node --test"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "minimatch": "^11.0.1"
  }
}
