{
  "name": "todo-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"index.html\" \"src/**/*.{jsx,css}\" \"vite.config.js\" \"eslint.config.js\" \"package.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"index.html\" \"src/**/*.{jsx,css}\" \"vite.config.js\" \"eslint.config.js\" \"package.json\" \".prettierrc.json\""
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
